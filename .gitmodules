[submodule "Catalpa/third_party/glfw"]
	path = Catalpa/third_party/glfw
	url = https://github.com/glfw/glfw.git
[submodule "Catalpa/third_party/spdlog"]
	path = Catalpa/third_party/spdlog
	url = https://github.com/gabime/spdlog.git
[submodule "Catalpa/third_party/imgui"]
	path = Catalpa/third_party/imgui
	url = https://github.com/ocornut/imgui.git

[submodule "Catalpa/third_party/glm"]
	path = Catalpa/third_party/glm
	url = https://github.com/g-truc/glm.git
[submodule "Catalpa/third_party/entt"]
	path = Catalpa/third_party/entt
	url = https://github.com/skypjack/entt.git

# GLM 1.0.3 and EnTT v4.0.0 currently come from complete upstream archives.
# These entries declare submodule paths/URLs; gitlink registration is not performed here.
# Ordinary source files are ignored; acquisition facts remain in Dependencies.lock.json.
