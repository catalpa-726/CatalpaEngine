{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Navigation build profiles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "default",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "default": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cellSize",
          "cellHeight",
          "agentHeight",
          "agentRadius",
          "maxClimb",
          "maxSlopeDegrees",
          "maxCells"
        ],
        "properties": {
          "cellSize": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 10
          },
          "cellHeight": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 10
          },
          "agentHeight": {
            "type": "number",
            "minimum": 0.03,
            "maximum": 100
          },
          "agentRadius": {
            "type": "number",
            "minimum": 0,
            "maximum": 20
          },
          "maxClimb": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "maxSlopeDegrees": {
            "type": "number",
            "minimum": 0,
            "maximum": 89.999
          },
          "maxCells": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        }
      }
    }
  }
}
