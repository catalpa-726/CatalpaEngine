{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalpa skeleton protocol version 1",
  "description": "Matches ReadSkeleton/WriteSkeleton. IDs identify source joints; the skeleton asset ID belongs to its container. Column vectors, parent*local and T*R*S; bind translations retain source local units and the explicit import-conversion root produces metres/Y-up. Rotation is unit w/x/y/z and matrices are column-major. Runtime additionally validates unique IDs, acyclic resolved parents, finite invertible bind transforms and inverse-bind agreement. Sources are never normalized or overwritten.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "joints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "name": {
            "type": "string",
            "maxLength": 1024
          },
          "parent": {
            "type": "integer",
            "minimum": -1,
            "maximum": 255
          },
          "bind": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "translation": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -3.402823466e+38,
                  "maximum": 3.402823466e+38
                }
              },
              "rotation": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": -3.402823466e+38,
                  "maximum": 3.402823466e+38
                }
              },
              "scale": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -3.402823466e+38,
                  "maximum": 3.402823466e+38
                }
              }
            },
            "required": [
              "translation",
              "rotation",
              "scale"
            ]
          },
          "inverseBind": {
            "type": "array",
            "minItems": 16,
            "maxItems": 16,
            "items": {
              "type": "number",
              "minimum": -3.402823466e+38,
              "maximum": 3.402823466e+38
            }
          }
        },
        "required": [
          "id",
          "name",
          "parent",
          "bind",
          "inverseBind"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "joints"
  ]
}
