              "Multiply",
              "Lerp",
              "OneMinus",
              "Sine",
              "Normal",
              "Alpha",
              "Split",
              "SurfaceOutput"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "parameter": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[^\\u0000]*$"
          },
          "semantic": {
            "type": "string",
            "maxLength": 128,
