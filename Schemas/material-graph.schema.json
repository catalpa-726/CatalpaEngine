  "required": [
    "schemaVersion",
    "shadingModel",
    "alphaMode",
    "parameters",
    "nodes",
    "links",
    "layout"
  ],
  "$comment": "Runtime validation enforces exact node port sets/types, one output, DAG, parameter ranges and one image per texture semantic; layout is excluded from the shader structural key."
}
