{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalpa blend-tree protocol version 1",
  "description": "Float parameters drive adjacent-threshold Blend1D, clip playback rates and ordered threshold transitions with crossfade durations in seconds. Runtime validates a DAG with resolved unique IDs, strictly ordered equally-sized thresholds, unique from/to transitions, fixed compatible clip/skeleton versions and a common root-motion joint. Shared active nodes advance once per instance per tick; inactive nodes freeze. Discrete events use the dominant branch, ties select the right branch. Canvas positions are authored document data; no retargeting or DCC feature is implied.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "skeleton": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "kind": {
            "enum": [
              "clip",
              "blend1d"
            ]
          },
          "clip": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "parameter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "children": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              }
            }
          },
          "thresholds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "items": {
              "type": "number",
              "minimum": -3.402823466e+38,
              "maximum": 3.402823466e+38
            }
          },
          "speed": {
            "type": "number",
            "minimum": -8,
            "maximum": 8
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "clip"
                }
              }
            },
            "then": {
              "required": [
                "clip"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "blend1d"
                }
              }
            },
            "then": {
              "required": [
                "parameter",
                "children",
                "thresholds"
              ],
              "properties": {
                "speed": {
                  "const": 1
                }
              }
            }
          }
        ]
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "node": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "id",
          "node",
          "name"
        ]
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "to": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "parameter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "threshold": {
            "type": "number",
            "minimum": -3.402823466e+38,
            "maximum": 3.402823466e+38
          },
          "greaterEqual": {
            "type": "boolean"
          },
          "duration": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "from",
          "to",
          "parameter",
          "threshold",
          "duration"
        ]
      }
    },
    "initialState": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "parameters": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "number",
        "minimum": -3.402823466e+38,
        "maximum": 3.402823466e+38
      }
    },
    "layout": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
        "not": {
          "const": "00000000-0000-0000-0000-000000000000"
        }
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "skeleton",
    "nodes",
    "states",
    "transitions",
    "initialState",
    "parameters"
  ]
}
