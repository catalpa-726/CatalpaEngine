{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalpa particle-effect protocol version 1",
  "description": "Matches ReadParticleEffect/WriteParticleEffect. Sizes are full billboard edges in metres, motion is metres/seconds and angular velocity is radians/second. Lifetime-normalized linear color and size curves use explicit endpoints. Runtime checks ordered intervals, nonzero seed, transparent fixed material with depth writes disabled, finite results, per-pool and per-Scene aggregate 16384 capacity. A deterministic bounded CPU pool feeds the ordinary transparent Renderer path; this is not a GPU effect graph.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "material": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "maxParticles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "emissionRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 65536
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "loop": {
      "type": "boolean"
    },
    "localSpace": {
      "type": "boolean"
    },
    "lifetime": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0.001,
        "maximum": 3600
      }
    },
    "size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1000
      }
    },
    "velocityMin": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -10000,
        "maximum": 10000
      }
    },
    "velocityMax": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -10000,
        "maximum": 10000
      }
    },
    "gravity": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -10000,
        "maximum": 10000
      }
    },
    "startColor": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 65504
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 65504
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 65504
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "items": false
    },
    "endColor": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 65504
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 65504
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 65504
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "items": false
    },
    "endSizeScale": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "angularVelocity": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": -10000,
        "maximum": 10000
      }
    }
  },
  "required": [
    "schemaVersion",
    "material",
    "seed",
    "maxParticles",
    "emissionRate",
    "duration",
    "loop",
    "localSpace",
    "lifetime",
    "size",
    "velocityMin",
    "velocityMax",
    "gravity",
    "startColor",
    "endColor",
    "endSizeScale",
    "angularVelocity"
  ]
}
