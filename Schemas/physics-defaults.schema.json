{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Physics defaults",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "maxBodies",
    "maxContacts",
    "maxEvents",
    "scratchBytes",
    "gravity",
    "collisionMasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "maxBodies": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "maxContacts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "maxEvents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "scratchBytes": {
      "type": "integer",
      "minimum": 1048576,
      "maximum": 268435456,
      "description": "Runtime additionally enforces 2 MiB + 2048*maxBodies + 128*maxContacts bytes."
    },
    "gravity": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -10000,
        "maximum": 10000
      }
    },
    "collisionMasks": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      }
    }
  }
}
