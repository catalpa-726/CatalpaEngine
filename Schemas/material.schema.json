{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalpa material definition or instance version 1",
  "description": "The production parser additionally checks duplicate stable IDs, exact integer tokens, finite float32 range, default and override types/ranges, allowed state changes, resolved texture semantics and final ShaderMetadata ABI. A PBR data definition is not a claim that the current renderer supports PBR lighting. No C++ object layout is serialized.",
  "oneOf": [
    {
      "$ref": "#/$defs/definition"
    },
    {
      "$ref": "#/$defs/instance"
    }
  ],
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "default"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "type": {
          "enum": [
            "float",
            "float2",
            "float3",
            "float4",
            "int",
            "uint",
            "bool",
            "texture2d"
          ]
        },
        "default": {},
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "allowOverride": {
          "type": "boolean"
        },
        "textureSemantic": {
          "enum": [
            "baseColor",
            "normal",
            "metallicRoughness",
            "emissive",
            "occlusion",
            "data"
          ]
        },
        "allowTextureFallback": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "float"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "float2"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "float3"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "float4"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "int"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "uint"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bool"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "texture2d"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                    "not": {
                      "const": "00000000-0000-0000-0000-000000000000"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "bool",
                  "texture2d"
                ]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "const": "texture2d"
                }
              }
            }
          },
          "then": {
            "properties": {
              "textureSemantic": {
                "const": "data"
              },
              "allowTextureFallback": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "renderState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cull": {
          "enum": [
            "none",
            "back",
            "front"
          ]
        },
        "depthTest": {
          "type": "boolean"
        },
        "depthWrite": {
          "type": "boolean"
        },
        "blend": {
          "enum": [
            "opaque",
            "alpha",
            "additive"
          ]
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "family",
        "shadingModel",
        "domain",
        "alphaMode",
        "shader",
        "vertexEntry",
        "fragmentEntry",
        "parameterBlock",
        "parameters"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "definition"
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
        },
        "shadingModel": {
          "enum": [
            "unlit",
            "pbr"
          ]
        },
        "domain": {
          "const": "surface"
        },
        "alphaMode": {
          "enum": [
            "opaque",
            "mask",
            "blend"
          ]
        },
        "shader": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "vertexEntry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "fragmentEntry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "parameterBlock": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "renderState": {
          "$ref": "#/$defs/renderState"
        },
        "allowedStateOverrides": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "cull",
              "depthTest",
              "depthWrite",
              "blend"
            ]
          }
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "definitionId",
        "definitionVersion",
        "revision"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "instance"
        },
        "definitionId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "definitionVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "parameters": {
          "type": "object",
          "maxProperties": 1024,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              {
                "type": "boolean"
              },
              {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                    "not": {
                      "const": "00000000-0000-0000-0000-000000000000"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            ]
          }
        },
        "renderState": {
          "$ref": "#/$defs/renderState"
        }
      }
    }
  }
}
