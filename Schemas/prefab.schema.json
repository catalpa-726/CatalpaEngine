{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalpa.engine/schemas/prefab.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scene": {
      "$ref": "scene.schema.json",
      "allOf": [
        {
          "properties": {
            "entities": {
              "items": {
                "not": {
                  "required": [
                    "prefab"
                  ]
                }
              },
              "contains": {
                "properties": {
                  "parent": {
                    "type": "null"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          }
        }
      ]
    },
    "nested": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "asset": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "parent": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "translation": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -3.4028234663852886e+38,
              "maximum": 3.4028234663852886e+38
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -3.4028234663852886e+38,
              "maximum": 3.4028234663852886e+38
            },
            "minItems": 4,
            "maxItems": 4
          },
          "scale": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -3.4028234663852886e+38,
              "maximum": 3.4028234663852886e+38
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "id",
          "asset",
          "parent",
          "translation",
          "rotation",
          "scale"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "scene",
    "nested"
  ],
  "$comment": "Slot identities and parents, dependency cycles, typed references and supported override conflicts are validated by Runtime/Tools."
}
