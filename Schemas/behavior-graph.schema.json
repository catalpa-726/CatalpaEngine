{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalpa.engine/schemas/behavior-graph.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "type": {
            "enum": [
              "Start",
              "Update",
              "Event",
              "SetNumber",
              "AddNumber",
              "Condition",
              "Translate",
              "Wait",
              "EmitEvent",
              "Stop"
            ]
          },
          "variable": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[^\\u0000]*$"
          },
          "event": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[^\\u0000]*$"
          },
          "number": {
            "type": "number",
            "minimum": -3.4028234663852886e+38,
            "maximum": 3.4028234663852886e+38
          },
          "vector": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -3.4028234663852886e+38,
              "maximum": 3.4028234663852886e+38
            },
            "minItems": 3,
            "maxItems": 3
          },
          "flow": {
            "type": "object",
            "maxProperties": 2,
            "propertyNames": {
              "enum": [
                "next",
                "true",
                "false"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              }
            }
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -1000000,
              "maximum": 1000000
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "id",
          "type",
          "variable",
          "event",
          "number",
          "vector",
          "flow",
          "position"
        ]
      }
    },
    "variables": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[^\\u0000]*$",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "number",
        "minimum": -3.4028234663852886e+38,
        "maximum": 3.4028234663852886e+38
      }
    }
  },
  "required": [
    "schemaVersion",
    "nodes",
    "variables"
  ],
  "$comment": "Control-flow cycles are legal and bounded by Runtime execution, event and wait budgets. Entry uniqueness and type-specific ports are checked in code; this is not a material DAG."
}
