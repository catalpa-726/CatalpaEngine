{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalpa animation-clip protocol version 1",
  "description": "Matches human-readable ReadAnimationClip/WriteAnimationClip; Cook also supports lossless explicit little-endian CANI1. Times/duration are seconds, quaternion values are unit w/x/y/z and cubic tangents are derivatives per second. The loader checks strictly increasing keys within duration, at most one million keys in total, resolved unique tracks, finite values and byte budgets. Events are ordered, occur before duration, names/payloads have UTF-8 byte limits. Root motion may select a real joint below an explicit import conversion root; no resampling or lossy compression is implicit.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "skeleton": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 86400
    },
    "rootMotionJoint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "tracks": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "joint": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "translation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "interpolation": {
                "enum": [
                  "step",
                  "linear",
                  "cubic"
                ]
              },
              "keys": {
                "type": "array",
                "maxItems": 1000000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "time": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 86400
                    },
                    "value": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number",
                        "minimum": -3.402823466e+38,
                        "maximum": 3.402823466e+38
                      }
                    },
                    "in": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number",
                        "minimum": -3.402823466e+38,
                        "maximum": 3.402823466e+38
                      }
                    },
                    "out": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number",
                        "minimum": -3.402823466e+38,
                        "maximum": 3.402823466e+38
                      }
                    }
                  },
                  "required": [
                    "time",
                    "value"
                  ]
                }
              }
            },
            "required": [
              "interpolation",
              "keys"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "interpolation": {
                      "const": "cubic"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "keys": {
                      "items": {
                        "required": [
                          "in",
                          "out"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          },
          "rotation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "interpolation": {
                "enum": [
                  "step",
                  "linear",
                  "cubic"
                ]
              },
              "keys": {
                "type": "array",
                "maxItems": 1000000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "time": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 86400
                    },
                    "value": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "number",
                        "minimum": -3.402823466e+38,
                        "maximum": 3.402823466e+38
                      }
                    },
                    "in": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "number",
                        "minimum": -3.402823466e+38,
                        "maximum": 3.402823466e+38
                      }
                    },
                    "out": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "number",
                        "minimum": -3.402823466e+38,
                        "maximum": 3.402823466e+38
                      }
                    }
                  },
                  "required": [
                    "time",
                    "value"
                  ]
                }
              }
            },
            "required": [
              "interpolation",
              "keys"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "interpolation": {
                      "const": "cubic"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "keys": {
                      "items": {
                        "required": [
                          "in",
                          "out"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          },
          "scale": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "interpolation": {
                "enum": [
                  "step",
                  "linear",
                  "cubic"
                ]
              },
              "keys": {
                "type": "array",
                "maxItems": 1000000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "time": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 86400
                    },
                    "value": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number",
                        "minimum": -3.402823466e+38,
                        "maximum": 3.402823466e+38
                      }
                    },
                    "in": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number",
                        "minimum": -3.402823466e+38,
                        "maximum": 3.402823466e+38
                      }
                    },
                    "out": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number",
                        "minimum": -3.402823466e+38,
                        "maximum": 3.402823466e+38
                      }
                    }
                  },
                  "required": [
                    "time",
                    "value"
                  ]
                }
              }
            },
            "required": [
              "interpolation",
              "keys"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "interpolation": {
                      "const": "cubic"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "keys": {
                      "items": {
                        "required": [
                          "in",
                          "out"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "required": [
          "joint"
        ]
      }
    },
    "events": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "time": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "payload": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "time",
          "name"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "skeleton",
    "duration",
    "tracks"
  ]
}
