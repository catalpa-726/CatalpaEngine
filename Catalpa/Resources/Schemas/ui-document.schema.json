{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "document", "files"],
  "properties": {
    "schemaVersion": {"const": 1},
    "document": {"type": "string", "minLength": 1, "maxLength": 1024},
    "files": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string"}},
    "inlineFiles": {"type": "object", "maxProperties": 128, "additionalProperties": {"type": "string", "maxLength": 2097152}},
    "images": {"type": "object", "maxProperties": 128, "additionalProperties": {"type": "string", "format": "uuid"}},
    "fonts": {"type": "object", "maxProperties": 16, "additionalProperties": {"type": "string", "format": "uuid"}},
    "fontSources": {"type": "object", "maxProperties": 16, "additionalProperties": {"type": "string", "maxLength": 32760}},
    "values": {"type": "object", "maxProperties": 256, "additionalProperties": {"type": "string", "maxLength": 65536}}
  }
}
